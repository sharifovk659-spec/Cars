# Telegram Cars — Deploy configuration (copy to deploy.env on server; DO NOT commit deploy.env)

# Server paths
DEPLOY_PATH=/home/u417315406/domains/inovaauto.com/public_html/carsbot
PRIVATE_CONFIG=/home/u417315406/domains/inovaauto.com/private/carsbot
BACKUP_DIR=/home/u417315406/domains/inovaauto.com/private/carsbot/backups

# Application
APP_URL=https://carsbot.inovaauto.com

# Git remote (optional — leave empty to use rsync only)
GIT_REMOTE=origin
GIT_BRANCH=main

# Database (used for backup only — credentials live in PRIVATE_CONFIG/database.php)
DB_HOST=localhost
DB_NAME=u417315406_carsbot
DB_USER=u417315406_carsbot
DB_PASSWORD=CHANGE_ME

# Deploy mode: 1 = dry-run (default), 0 = real deploy
DRY_RUN=1

# Method: git | rsync
DEPLOY_METHOD=git

# Rsync source (local machine path when pushing from dev)
RSYNC_SOURCE=
